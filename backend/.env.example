# Banco
DATABASE_URL=sqlite:///./techgen.db

# Segurança (gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (CSV)
ALLOWED_ORIGINS=http://localhost:5173

# IA — Abacus (endpoint RouteLLM, compatível com OpenAI)
AI_PROVIDER=fake
ABACUS_API_URL=https://routellm.abacus.ai
ABACUS_API_KEY=
ABACUS_MODEL=gpt-5
# Modelo leve para o diagnóstico inicial; fallback transparente em ABACUS_MODEL
ABACUS_QUESTIONS_MODEL=gemini-3.5-flash
# Modelo que abstrai os concepts dos tickets em poucas skills genéricas
# (chamada barata, payload pequeno). Fallback transparente em ABACUS_MODEL.
ABACUS_CATEGORIZER_MODEL=claude-haiku-4-5-20251001
ABACUS_TIMEOUT_SECONDS=300
